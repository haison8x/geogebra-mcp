{
  "name": "geogebra-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI draw and edit geometry directly on GeoGebra Calculator (geogebra.org/calculator) through Playwright",
  "keywords": [
    "mcp",
    "geogebra",
    "geometry",
    "claude",
    "playwright"
  ],
  "author": "haison8x",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haison8x/geogebra-mcp.git"
  },
  "homepage": "https://github.com/haison8x/geogebra-mcp#readme",
  "bugs": {
    "url": "https://github.com/haison8x/geogebra-mcp/issues"
  },
  "type": "module",
  "bin": {
    "geogebra-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist/*.js",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3"
  }
}
